{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/specforge-ai/events/v1.schema.json",
  "title": "SpecForge AI candidate typed domain events v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "tenant_id",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "requirement.revision_created"
        },
        "event_version": {
          "type": "integer",
          "const": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision_id",
            "requirement_set_id",
            "source_digest",
            "requirement_count",
            "critical_ambiguity_count"
          ],
          "properties": {
            "revision_id": {
              "type": "string",
              "format": "uuid"
            },
            "requirement_set_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "requirement_count": {
              "type": "integer",
              "minimum": 0
            },
            "critical_ambiguity_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "tenant_id",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "ambiguity.decided"
        },
        "event_version": {
          "type": "integer",
          "const": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ambiguity_id",
            "decision_id",
            "decider_id",
            "source_reference",
            "decision_digest"
          ],
          "properties": {
            "ambiguity_id": {
              "type": "string",
              "format": "uuid"
            },
            "decision_id": {
              "type": "string",
              "format": "uuid"
            },
            "decider_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_reference": {
              "type": "string",
              "minLength": 1
            },
            "decision_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "tenant_id",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "spec.revision_approved"
        },
        "event_version": {
          "type": "integer",
          "const": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision_id",
            "reviewer_id",
            "spec_sha256",
            "validator_report_sha256",
            "traceability_report_sha256"
          ],
          "properties": {
            "revision_id": {
              "type": "string",
              "format": "uuid"
            },
            "reviewer_id": {
              "type": "string",
              "format": "uuid"
            },
            "spec_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "validator_report_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "traceability_report_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  ]
}
